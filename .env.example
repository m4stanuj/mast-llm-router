# ─────────────────────────────────────────────────────────────
#  MAST LLM Router — .env.example
#  Copy to .env and fill in your keys.
#  Keys are NEVER committed to git (see .gitignore).
# ─────────────────────────────────────────────────────────────

# ── SMART KEY SLOTS (recommended) ────────────────────────────
# Paste ANY key here — the router auto-detects the provider
# by prefix (gsk_ = Groq, csk- = Cerebras, AIza = Gemini, etc.)
# Supports up to SMART_KEY_30

SMART_KEY_1=
SMART_KEY_2=
SMART_KEY_3=
SMART_KEY_4=
SMART_KEY_5=

# ── OR use named keys per provider ───────────────────────────
# Each provider supports up to _API_KEY_20 for key rotation

# Groq (free: 6000 tokens/min) — https://console.groq.com
GROQ_API_KEY=
# GROQ_API_KEY_1=
# GROQ_API_KEY_2=

# Cerebras (free: fast inference) — https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Google Gemini (free tier) — https://aistudio.google.com
GEMINI_API_KEY=

# OpenRouter (many free models) — https://openrouter.ai
OPENROUTER_API_KEY=

# NVIDIA NIM (free 40 RPM) — https://build.nvidia.com
NVIDIA_API_KEY=

# SambaNova (free Llama 405B) — https://cloud.sambanova.ai
SAMBANOVA_API_KEY=

# DeepSeek — https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Together AI — https://api.together.xyz
TOGETHER_API_KEY=

# Mistral — https://console.mistral.ai
MISTRAL_API_KEY=

# xAI / Grok — https://console.x.ai
GROKAI_API_KEY=

# HuggingFace — https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# ── Optional: override config directory ──────────────────────
# MAST_CONFIG=/path/to/your/config/dir
